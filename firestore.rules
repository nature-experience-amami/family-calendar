rules_version = '2';

// 家族カレンダーのセキュリティルール
//
// データの置き場所
//   families/{familyId}/private/invite   招待コード { code: "..." }（アプリからは読めない。Firebaseの画面で作る）
//   families/{familyId}/members/{uid}    参加した端末 { member, inviteCode, joinedAt }
//   families/{familyId}/events/{eventId} 予定と送迎の担当
//     { member, title, date, endDate, allDay, start, end, ride, createdBy, createdAt, updatedAt }
//   families/{familyId}/profiles/{memberId} 名前とアイコン・休みの決まり { name, icon, offDays, holidayOff, updatedBy, updatedAt }
//   families/{familyId}/dayoffs/{日付_人}  その日だけの休みの変更 { member, date, off, updatedBy, updatedAt }
//
// 家族は固定ID（father / mother / son / daughter）で表す。
// 以前の版で保存された予定の papa / mama も読み書きできるように残している。
//
// 招待コードが合っている端末だけが members に自分を登録でき、
// members に登録された端末だけが予定を読み書きできる。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function inviteCodeOk(familyId, code) {
      let invite = /databases/$(database)/documents/families/$(familyId)/private/invite;
      return code is string
        && exists(invite)
        && get(invite).data.code == code;
    }

    function validMember(id) {
      return id in ['father', 'mother', 'son', 'daughter'];
    }

    // 予定の中だけ、以前の版のID（papa / mama）も認める
    function validEventMember(id) {
      return validMember(id) || id in ['papa', 'mama'];
    }

    function validDriver(id) {
      return id in ['father', 'mother', 'papa', 'mama'];
    }

    function isTime(t) {
      return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validLeg(leg) {
      return leg is map
        && leg.keys().hasOnly(['time', 'driver'])
        && leg.keys().hasAll(['time', 'driver'])
        && isTime(leg.time)
        && (leg.driver == null || validDriver(leg.driver));
    }

    function validRide(ride) {
      return ride == null
        || (ride is map
          && ride.keys().hasOnly(['go', 'back'])
          && ride.size() > 0
          && (!('go' in ride) || validLeg(ride.go))
          && (!('back' in ride) || validLeg(ride.back)));
    }

    function isDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function dayOf(s) {
      return timestamp.date(int(s[0:4]), int(s[5:7]), int(s[8:10]));
    }

    // 何日か続く予定は、終わりの日が始まりの日から62日先まで
    // （アプリが表示期間の分だけ読み込むときに、この幅で探しているため）
    function spanOk(from, to) {
      return dayOf(to) <= dayOf(from) + duration.value(62, 'd');
    }

    // 日時：終日なら時間なし。時間付きなら開始時間は必須、終了時間は任意。
    // 1日だけの予定は、終了時間が開始時間より前ならだめ。
    // allDay・endDate は以前の版の予定に無いので、無くてもよい。
    function validWhen(d) {
      let allDay = d.get('allDay', false);
      let endDate = d.get('endDate', null);
      let multiDay = endDate != null;
      return allDay is bool
        && (endDate == null || (isDate(endDate) && endDate > d.date && spanOk(d.date, endDate)))
        && (allDay
          ? (d.start == null && d.end == null)
          : (isTime(d.start)
            && (d.end == null || (isTime(d.end) && (multiDay || d.end >= d.start)))));
    }

    function validEvent(d) {
      return d.keys().hasOnly(['member', 'title', 'date', 'endDate', 'allDay', 'start', 'end', 'ride', 'createdBy', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['member', 'title', 'date', 'start', 'end', 'ride', 'createdBy', 'createdAt', 'updatedAt'])
        && validEventMember(d.member)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && isDate(d.date)
        && validWhen(d)
        && validRide(d.ride)
        && d.updatedAt == request.time;
    }

    // 招待コード：アプリからは読み書きできない（ルールの中の get() だけが読む）
    match /families/{familyId}/private/{doc} {
      allow read, write: if false;
    }

    // 参加した端末
    match /families/{familyId}/members/{uid} {
      // 家族は全員分を読める。参加前の端末は、自分の分があるかどうかだけ確かめられる
      allow read: if isMember(familyId) || (signedIn() && request.auth.uid == uid);

      // 参加・自分が誰かの変更：自分の分だけ、正しい招待コード付きで
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['member', 'inviteCode', 'joinedAt'])
        && request.resource.data.keys().hasAll(['member', 'inviteCode', 'joinedAt'])
        && validMember(request.resource.data.member)
        && request.resource.data.joinedAt is timestamp
        && inviteCodeOk(familyId, request.resource.data.inviteCode);

      // 抜けるのは自分だけ（ほかの端末を外すときは Firebase の画面で消す）
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // 予定
    match /families/{familyId}/events/{eventId} {
      allow read: if isMember(familyId);

      allow create: if isMember(familyId)
        && validEvent(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isMember(familyId)
        && validEvent(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      // 削除は今の画面に無いので、まだ許可しない
      allow delete: if false;
    }

    // 名前とアイコン：参加している家族なら誰でも4人分を変えられる
    match /families/{familyId}/profiles/{memberId} {
      allow read: if isMember(familyId);

      allow create, update: if isMember(familyId)
        && validMember(memberId)
        && request.resource.data.keys().hasOnly(['name', 'icon', 'offDays', 'holidayOff', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'icon', 'updatedBy', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 10
        && !request.resource.data.name.matches('^\\s*$')
        && request.resource.data.icon in ['cat', 'rabbit', 'bird', 'fish', 'star', 'flower', 'sun', 'moon']
        // 休みの決まり（無くてもよい）：いつも休みの曜日（0＝日〜6＝土）と、祝日は休みか
        && (!('offDays' in request.resource.data)
          || (request.resource.data.offDays is list
            && request.resource.data.offDays.size() <= 7
            && request.resource.data.offDays.hasOnly([0, 1, 2, 3, 4, 5, 6])))
        && (!('holidayOff' in request.resource.data) || request.resource.data.holidayOff is bool)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // その日だけの休みの変更：ID は「日付_人」（例 2026-11-03_father）
    // off＝true ならその日は休み、false なら仕事・学校。いつもどおりに戻すときは消す
    match /families/{familyId}/dayoffs/{dayoffId} {
      allow read: if isMember(familyId);

      allow create, update: if isMember(familyId)
        && request.resource.data.keys().hasOnly(['member', 'date', 'off', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['member', 'date', 'off', 'updatedBy', 'updatedAt'])
        && validMember(request.resource.data.member)
        && isDate(request.resource.data.date)
        && dayoffId == request.resource.data.date + '_' + request.resource.data.member
        && request.resource.data.off is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if isMember(familyId);
    }

    // それ以外は全部だめ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
